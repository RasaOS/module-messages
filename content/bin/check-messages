#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""check-messages — validate the messages ledger against .claude/messages-rules.md.

Exit 0 = no errors (warnings allowed), 1 = errors, 2 = cannot run.
`--fix` repairs the mechanical subset and never invents a person, a date or a status.
"""
import os
import sys

sys.dont_write_bytecode = True
_HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, _HERE)

from rasa_messages import validate  # noqa: E402

if __name__ == "__main__":
    sys.exit(validate.main(bin_dir=os.path.dirname(os.path.abspath(__file__))))
