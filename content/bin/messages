#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""messages — rasa.module.messages: every kind of message as records (email, texts,
chat, calls, voicemail, letters, faxes). Records and drafts; never sends.

The law is .claude/messages-rules.md. Run `messages --help`, or `messages <verb> --help`.
Pure Python 3 standard library; no network, no version control.
"""
import os
import sys

sys.dont_write_bytecode = True
_HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, _HERE)

from rasa_messages import cli  # noqa: E402

if __name__ == "__main__":
    sys.exit(cli.main(bin_dir=os.path.dirname(os.path.abspath(__file__))))
